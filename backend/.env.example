# =============================================================================
# All-in-One Toolbox - Backend Environment Variables
# =============================================================================
# Copy this file to .env and update values

# Application
APP_NAME=All-in-One Toolbox
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Allowed origins (comma-separated)
# For production, only include your actual domain
CORS_ORIGINS=["https://333654.xyz"]

# Gotenberg PDF Service
GOTENBERG_URL=http://gotenberg:7000
GOTENBERG_TIMEOUT=5.0

# File Upload
MAX_FILE_SIZE_BYTES=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# Concurrency
MAX_CONCURRENT_CONVERSIONS=2

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Monitoring (optional)
# SENTRY_DSN=https://example@sentry.io/project
